# NAV KURD public browser configuration template.
# Copy to a private .env.local for local development or configure the same
# browser-safe values in Vercel. Never commit secret/service-role credentials.

VITE_KRI_MAP_DATA_VERSION=2026-07-22-nav-kurd-systematic-dedupe-2027
VITE_KRI_PMTILES_URL=/data/kri/kri-base.pmtiles
VITE_KRI_ROADS_PMTILES_URL=/data/kri/kri-roads.pmtiles

VITE_KRI_ENABLE_SATELLITE=true
VITE_KRI_SATELLITE_PROVIDER=maptiler
VITE_KRI_MAPTILER_TILESET_ID=satellite-v2
VITE_KRI_MAPTILER_API_KEY=YOUR_RESTRICTED_MAPTILER_BROWSER_KEY
VITE_KRI_ENABLE_SENTINEL_OVERLAY=false

# Server-only Copernicus Data Space OAuth credentials for the Sentinel-2 proxy.
# Configure these as Sensitive variables in Vercel. Never prefix them with VITE_.
CDSE_SH_CLIENT_ID=YOUR_COPERNICUS_OAUTH_CLIENT_ID
CDSE_SH_CLIENT_SECRET=YOUR_COPERNICUS_OAUTH_CLIENT_SECRET
# Optional server-side freshness window; defaults to 45 days (allowed range 10-120).
# Sentinel-2 is used through zoom 13; the existing restricted MapTiler key supplies automatic close-zoom detail.
# CDSE_SH_LOOKBACK_DAYS=45

# Optional custom satellite source instead of MapTiler.
# VITE_KRI_SATELLITE_TILEJSON_URL=
# VITE_KRI_SATELLITE_TILE_TEMPLATE=
# VITE_KRI_SATELLITE_ATTRIBUTION=

VITE_KRI_ROUTING_PROVIDER=mapbox
VITE_KRI_ROUTING_PROFILE=driving-traffic
VITE_KRI_MAPBOX_ACCESS_TOKEN=pk.YOUR_RESTRICTED_PUBLIC_TOKEN
VITE_KRI_ROUTE_REFRESH_SECONDS=8
VITE_KRI_ROUTE_REROUTE_METERS=25

# Optional OSRM fallback endpoint.
# VITE_KRI_ROUTING_BASE_URL=https://router.project-osrm.org

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_KRI_MEDIA_BUCKET=kri-place-media
VITE_KRI_PRIVATE_MEDIA_BUCKET=kri-place-media-private

# Optional Vite base path; leave as / for the canonical Vercel deployment.
VITE_BASE_PATH=/
# Optional weather endpoint override. The app defaults to Open-Meteo and does not require a key.
# For commercial or self-hosted deployments, point this to the endpoint covered by your provider plan.
# Optional override. Leave unset on Vercel to use the resilient same-origin /api/weather proxy.
# VITE_KRI_WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast


# Sentinel proxy request-origin hardening. Use comma-separated exact origins.
# Requests without a same-origin browser signal, matching Origin, or matching
# Referer are rejected unless NAV_KURD_ALLOW_ORIGINLESS_SENTINEL=true is set.
NAV_KURD_CANONICAL_ORIGIN=https://geo-map-kappa.vercel.app
NAV_KURD_SENTINEL_ALLOWED_ORIGINS=https://geo-map-kappa.vercel.app
# NAV_KURD_ALLOW_ORIGINLESS_SENTINEL=false

VITE_PUBLIC_APP_URL=https://geo-map-kappa.vercel.app

# Optional: genuine IARC certificate ID from the store rating questionnaire.
NAV_KURD_IARC_RATING_ID=
# Enable only after applying Supabase migration 20260718_000018_public_directory_consent_privacy.sql
VITE_KRI_PUBLIC_DIRECTORY_CONSENT_RPC=true

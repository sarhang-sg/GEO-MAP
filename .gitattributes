# Deterministic cross-platform checkouts. Source-data hashes must be identical on
# Linux, macOS and Windows GitHub Actions runners.
* text=auto eol=lf

*.json text eol=lf
*.geojson text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.plist text eol=lf
*.swift text eol=lf
*.rs text eol=lf

# Binary assets and deterministic compressed source archives.
*.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pmtiles binary
*.zip binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
